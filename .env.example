# Public client configuration for NCC Two-Day Event Website
# NEVER put your Supabase service_role key or payment secrets here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional college & event metadata overrides
COLLEGE_NAME=Your College Name
NCC_UNIT=College NCC Unit
EVENT_DATES=Dates to be announced (2-Day Event)
EVENT_VENUE=College Campus & Parade Ground
CONTACT_EMAIL=ncc.event@college.edu
CONTACT_PHONE=+91 90000 00000
SIGNATORY_NAME=Associate NCC Officer (ANO)
SIGNATORY_TITLE=NCC Unit / Event Convenor

# Public Razorpay Key ID only; server secrets must be set in Vercel
RAZORPAY_KEY_ID=rzp_test_replace_me
DEMO_PAYMENT_MODE=false
# Server-only variables (never expose in scripts/config.js):
# RAZORPAY_KEY_SECRET=replace_me
# SUPABASE_SERVICE_ROLE_KEY=replace_me
